# OPTIONAL. Copy to `.env` for local development; `.env` is gitignored.
#
# You do not need this file: the app asks for a Google Maps key on first load
# and keeps it in your browser. Setting the key here just skips that prompt.
# A key typed into the app always takes precedence over this one.
#
# Google Cloud console > APIs & Services:
#   - Enable "Maps JavaScript API" and "Places API (New)"
#   - Create an API key, then restrict it:
#       Application restrictions -> Websites (HTTP referrers):
#         http://localhost:5173/*
#         https://<your-github-username>.github.io/land-master/*
#       API restrictions -> Maps JavaScript API, Places API (New)
#
# Vite bakes VITE_* vars into the bundle at BUILD time. On a static site the key
# is always visible in the shipped JS — the HTTP-referrer restriction is what
# actually protects it, not secrecy.
VITE_GOOGLE_MAPS_API_KEY=your-browser-key-here

# Optional. A Cloud-console Map ID enables vector maps / custom styling.
# Leave unset to use the default raster map.
# VITE_GOOGLE_MAPS_MAP_ID=

# Optional. Overrides the base path used at build time (default: "/land-master/").
# Set to "/" if you deploy to a user/org root Pages site (<user>.github.io).
# VITE_BASE=/land-master/
